# ─────────────────────────────────────────────────────────────────
#  EasyJob — variables d'environnement (modèle)
#  Copiez ce fichier en `.env` et renseignez vos propres valeurs.
#  Ne committez JAMAIS le fichier `.env` réel (il est déjà dans .gitignore).
# ─────────────────────────────────────────────────────────────────

# Base de données
MONGODB_URI=mongodb+srv://user:motdepasse@cluster.mongodb.net/easyjob

# Sécurité (générez des chaînes aléatoires longues)
JWT_SECRET=changez_moi_avec_une_chaine_longue_aleatoire
JWT_REFRESH_SECRET=changez_moi_avec_une_autre_chaine_aleatoire

# ─────────────────────────────────────────────────────────────────
#  EMAIL — adresse unique de la plateforme
#  easyjobmarocsupport@gmail.com expédie TOUS les messages :
#  codes de confirmation, réinitialisation de mot de passe, candidatures,
#  et sert de support utilisateur (champ Reply-To).
# ─────────────────────────────────────────────────────────────────

# Adresse de support (affichée dans le frontend et en pied des emails)
SUPPORT_EMAIL=easyjobmarocsupport@gmail.com

# Fournisseur : brevo | resend | smtp
# Sans valeur, détection automatique (Brevo si BREVO_API_KEY est défini).
EMAIL_PROVIDER=brevo

# ── Brevo (RECOMMANDÉ en production, obligatoire sur Vercel) ──────
# Console Brevo → "SMTP & API" → "API Keys" → Generate New Key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# L'expéditeur DOIT être vérifié dans Brevo → "Senders & IP" → "Senders"
# Sinon Brevo rejette l'envoi (erreur 403 "unauthorized sender").
BREVO_SENDER_EMAIL=easyjobmarocsupport@gmail.com
BREVO_SENDER_NAME=EasyJob Support
# Adresse recevant les réponses des utilisateurs (optionnel, défaut : l'expéditeur)
# SUPPORT_REPLY_TO=easyjobmarocsupport@gmail.com

# ── SMTP Gmail (UNIQUEMENT en local, bloqué depuis Vercel) ───────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=easyjobmarocsupport@gmail.com
# EMAIL_PASS=code_google_application_a_16_caracteres
# EMAIL_FROM=EasyJob Support <easyjobmarocsupport@gmail.com>

# ─────────────────────────────────────────────────────────────────
#  Serveur
# ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Budget de collecte par source (ms). 40000 sur Vercel, 360000 en serveur persistant.
# SCRAPING_BUDGET_MS=40000

# ─────────────────────────────────────────────────────────────────
#  Compte administrateur
#  Il n'existe plus de compte par défaut (admin@gmail.com / admin123) :
#  sans ces deux variables, aucun administrateur n'est créé au démarrage
#  et l'espace /admin reste inaccessible. Le mot de passe doit faire
#  au moins 12 caractères.
# ─────────────────────────────────────────────────────────────────
# ADMIN_EMAIL=admin@votre-domaine.com
# ADMIN_PASSWORD=un_mot_de_passe_robuste_et_unique

# ─────────────────────────────────────────────────────────────────
#  Développement uniquement
#  ALLOW_CODE_FALLBACK=true renvoie le code de vérification dans la réponse
#  API quand l'envoi d'email échoue. Ignoré en production, qui n'expose
#  jamais le code. Laisser désactivé au maximum.
# ─────────────────────────────────────────────────────────────────
# ALLOW_CODE_FALLBACK=true

# ─────────────────────────────────────────────────────────────────
#  Frontend (Vercel → Settings → Environment Variables)
#  Sans VITE_SOCKET_URL, le client ne tente plus de connexion WebSocket
#  (impossible sur une fonction serverless) et les notifications restent
#  rafraîchies par polling.
# ─────────────────────────────────────────────────────────────────
# VITE_API_URL=/api
# VITE_SOCKET_URL=https://votre-serveur-persistant.example.com
